# Copia este archivo a .env y completa los valores en tu equipo.
# DB_PORT debe coincidir con el puerto publicado por Docker en tu Mac.
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=DentalCareDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USER= TU_USUARIO
DB_PASSWORD= TU_CONTRASEÑA
DB_ENCRYPT=yes
# yes permite el certificado del SQL Server local de Docker.
# Para un servidor con certificado válido, utiliza no.
DB_TRUST_SERVER_CERTIFICATE=yes
